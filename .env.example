# Gemini model used by the memo writer (check AI Studio for current model names)
GEMINI_MODEL=gemini-3.5-flash-lite
# (optional) List price per million tokens in EUR, only used to report cost per request
LLM_EUR_PER_M_INPUT=0.28
LLM_EUR_PER_M_OUTPUT=2.30
# (optional) Set to 1 only in evaluation runs: caches Gemini answers on disk
LLM_CACHE=0
GEMINI_API_KEY=